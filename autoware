#!/usr/bin/env bash

set -e

# 스크립트가 있는 Autoware 폴더로 이동
cd "$(dirname "$(readlink -f "$0")")"

# Docker 컨테이너가 호스트 화면을 사용할 수 있도록 허용
xhost +local:docker > /dev/null

# 호스트 사용자 UID/GID 전달
export HOST_UID="$(id -u)"
export HOST_GID="$(id -g)"

# Autoware Planning Simulator와 RViz 실행
exec docker compose \
  -f docker/examples/basic/dev-nvidia.compose.yaml \
  run --rm autoware \
  bash -lc 'source /opt/autoware/setup.bash; (until ros2 param set /planning/scenario_planning/external_velocity_limit_selector max_vel 16.67 >/dev/null 2>&1; do sleep 1; done; ros2 param set /planning/scenario_planning/lane_driving/behavior_planning/behavior_path_planner max_vel 16.67 >/dev/null; ros2 param set /planning/scenario_planning/velocity_smoother max_vel 16.67 >/dev/null; ros2 topic pub --once --qos-durability transient_local /planning/scenario_planning/clear_velocity_limit autoware_internal_planning_msgs/msg/VelocityLimitClearCommand "{command: true, sender: rviz2(autoware_state_panel)}" >/dev/null; exec ros2 topic pub -r 1 /planning/scenario_planning/max_velocity autoware_internal_planning_msgs/msg/VelocityLimit "{max_velocity: 16.67, use_constraints: false, sender: autoware_run}" >/dev/null) & exec ros2 launch autoware_launch planning_simulator.launch.xml map_path:=/home/aw/vtd_autoware_maps/HL_FMA_VTD_LivingLab_topology_fixed vehicle_model:=sample_vehicle sensor_model:=sample_sensor_kit scenario_simulation:=true localization_sim_mode:=none use_sim_time:=true enable_all_modules_auto_mode:=true launch_run_out_module:=false'
