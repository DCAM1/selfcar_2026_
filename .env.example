# Immutable Autoware base image used by docker/vtd/Dockerfile.
AUTOWARE_BASE_IMAGE=ghcr.io/autowarefoundation/autoware@sha256:86d12e0f2504b058b54faead3a6113b5777c778899fc7a7c362e787808fdac24

# Local name for the image produced by scripts/build-vtd-image.sh.
VTD_IMAGE=selfcar-2026-vtd:local

# External data. Do not commit .env or any of these directories.
AUTOWARE_MAP_DIR=/absolute/path/to/autoware_data/maps
AUTOWARE_ML_MODELS_DIR=/absolute/path/to/autoware_data/ml_models
VTD_MAP_DIR=/absolute/path/to/vtd_autoware_maps
VTD_MAP_RELATIVE_PATH=HL_FMA_VTD_LivingLab_topology_fixed
VTD_INSTALL_DIR=/absolute/path/to/VIRES/VTD.2025.2

# GUI and optional host identity values.
DISPLAY=:0
HOST_UID=1000
HOST_GID=1000
