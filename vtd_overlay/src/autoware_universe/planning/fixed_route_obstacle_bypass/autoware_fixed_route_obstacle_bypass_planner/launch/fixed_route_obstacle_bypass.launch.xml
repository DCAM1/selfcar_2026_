<launch>
  <arg name="launch_planner" default="true"/>
  <arg name="launch_final_validator" default="false"/>
  <arg name="exclusive_mode_verified" default="false"/>
  <arg name="input_trajectory" default="/planning/scenario_planning/lane_driving/motion_planning/path_optimizer/trajectory"/>
  <arg name="output_trajectory" default="/planning/scenario_planning/lane_driving/motion_planning/fixed_route_obstacle_bypass/trajectory"/>
  <arg name="final_input_trajectory" default="/planning/scenario_planning/velocity_smoother/trajectory"/>
  <arg name="final_output_trajectory" default="/planning/scenario_planning/fixed_route_final_validator/trajectory"/>
  <arg name="input_objects" default="/perception/object_recognition/objects"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_path_with_lane_id" default="/planning/scenario_planning/lane_driving/behavior_planning/path_with_lane_id"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_external_velocity_limit" default="/planning/scenario_planning/max_velocity"/>
  <arg name="planner_state" default="/planning/scenario_planning/lane_driving/motion_planning/fixed_route_obstacle_bypass/state"/>
  <arg name="param_path" default="$(find-pkg-share autoware_fixed_route_obstacle_bypass_planner)/config/fixed_route_obstacle_bypass.param.yaml"/>
  <arg name="common_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/common.param.yaml"/>
  <arg name="velocity_smoother_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/autoware_velocity_smoother/velocity_smoother.param.yaml"/>
  <arg name="jerk_filtered_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/autoware_velocity_smoother/JerkFiltered.param.yaml"/>
  <arg name="vehicle_param_path" default="$(find-pkg-share sample_vehicle_description)/config/vehicle_info.param.yaml"/>

  <node if="$(var launch_planner)" pkg="autoware_fixed_route_obstacle_bypass_planner" exec="fixed_route_obstacle_bypass_planner_node" name="fixed_route_obstacle_bypass_planner" output="screen">
    <remap from="~/input/trajectory" to="$(var input_trajectory)"/>
    <remap from="~/input/objects" to="$(var input_objects)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/path_with_lane_id" to="$(var input_path_with_lane_id)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/external_velocity_limit" to="$(var input_external_velocity_limit)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/state" to="$(var planner_state)"/>
    <param from="$(var common_param_path)"/>
    <param from="$(var velocity_smoother_param_path)"/>
    <param from="$(var jerk_filtered_param_path)"/>
    <param from="$(var vehicle_param_path)"/>
    <param from="$(var param_path)"/>
    <param name="fixed_route_bypass.exclusive_mode_verified" value="$(var exclusive_mode_verified)"/>
  </node>

  <node if="$(var launch_final_validator)" pkg="autoware_fixed_route_obstacle_bypass_planner" exec="fixed_route_final_trajectory_validator_node" name="fixed_route_final_trajectory_validator" output="screen">
    <remap from="~/input/trajectory" to="$(var final_input_trajectory)"/>
    <remap from="~/input/regulatory_reference" to="$(var input_trajectory)"/>
    <remap from="~/input/objects" to="$(var input_objects)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/path_with_lane_id" to="$(var input_path_with_lane_id)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/planner_state" to="$(var planner_state)"/>
    <remap from="~/output/trajectory" to="$(var final_output_trajectory)"/>
    <param from="$(var vehicle_param_path)"/>
    <param from="$(var param_path)"/>
    <param name="fixed_route_bypass.exclusive_mode_verified" value="$(var exclusive_mode_verified)"/>
  </node>
</launch>
